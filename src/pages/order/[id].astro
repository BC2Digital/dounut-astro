---
import { getOrderById } from "../../use-cases/queries/get-order";
import Layout from "../../layouts/Layout.astro";
import { Order } from "../../components/order";

const { id } = Astro.params;
const order = id ? await getOrderById(id) : null;
---

<Layout title="Pedido confirmado" description="Confirmação do pedido">
  <div class="lg:container mx-auto w-full lg:px-0 px-5">
    {
      order ? (
        <Order order={order} client:load />
      ) : (
        <p>Pedido não encontrado.</p>
      )
    }
  </div>
</Layout>
