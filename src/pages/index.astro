---
import { FeaturedItem } from "../components/featured-item";
import { ProductRow } from "../components/product-row";
import { Products } from "../components/products";
import Layout from "../layouts/Layout.astro";
import { fetchFrontPage } from "../use-cases/queries/frontpage.ts";

const { produtos } = await fetchFrontPage(14);

const destaque1 = produtos[0];
const linha1 = produtos.slice(1, 4);
const destaque2 = produtos[4];
const linha2 = produtos.slice(5, 8);
const grade = produtos.slice(8, 14);
---

<Layout
  title="Hella Confeitaria"
  description="Bolos, doces e mimos artesanais da Hella Confeitaria.">
  <div class="py-10 lg:container mx-auto w-full md:px-0 px-3 flex flex-col gap-4">
    {destaque1 && <FeaturedItem produto={destaque1} client:load />}
    <ProductRow produtos={linha1} client:load />

    {destaque2 && <FeaturedItem produto={destaque2} client:load />}
    <ProductRow produtos={linha2} client:load />

    <Products produtos={grade} verMaisHref="/produtos" client:load />
  </div>
</Layout>
