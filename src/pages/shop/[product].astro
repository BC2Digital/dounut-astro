---
import { fetchAllProductSlugs } from "../../use-cases/queries/all-products";
import { fetchProduct } from "../../use-cases/queries/product";

import Layout from "../../layouts/Layout.astro";
import { Product as HellaProduct } from "../../components/product";

export const prerender = true;

export async function getStaticPaths() {
  const produtos = await fetchAllProductSlugs();
  return produtos
    .filter((p: { slug: string | null }) => p.slug)
    .map((p: { slug: string }) => ({ params: { product: p.slug } }));
}

const { product: slug } = Astro.params;
const { produto, relacionados } = await fetchProduct(slug as string);
---

<Layout title={produto?.nome ?? "Produto"} description={produto?.descricao ?? "Produto Hella Confeitaria"}>
  <div class="lg:container mx-auto w-full lg:px-0 px-5">
    {
      produto ? (
        <HellaProduct produto={produto} relacionados={relacionados} client:load />
      ) : (
        <p>Produto não encontrado</p>
      )
    }
  </div>
</Layout>
